NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only (never NEXT_PUBLIC_): lets the server cache exchange rates in fx_rates.
# Supabase dashboard > Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Web Push (Milestone 8). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# Server only:
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=https://your-site.example
# Shared secret the database sends with each activity webhook (also stored in private.app_settings).
PUSH_WEBHOOK_SECRET=a-long-random-string
